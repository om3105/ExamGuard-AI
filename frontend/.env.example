# Frontend Environment Variables Template
# Copy this file to .env and adjust the URLs for your environment.

# API base URL for the student portal.
# Local development: http://localhost:8000
# Leave empty (or omit) only when using an ngrok/reverse-proxy that serves
# both the frontend and backend on the same origin.
VITE_USER_API_URL=http://localhost:8000

# API base URL for the admin portal.
# For a same-origin proxy setup you can use the relative path /admin/api.
VITE_ADMIN_API_URL=http://localhost:8000/admin/api

# External services
VITE_JUDGE0_API_URL=https://ce.judge0.com
