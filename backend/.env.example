# ──────────────────────────────────────────────
# ExamGuard AI Backend Configuration Boilerplate
# ──────────────────────────────────────────────

# --- Runtime Environment ---
# Set to 'production' to enforce strict security
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- MongoDB Database ---
# The connection string for motor/beanie
MONGODB_URL=mongodb://localhost:27017/examguard
DB_NAME=examguard

# --- Security & JWT (Student Auth) ---
# Must be a secure 256-bit random string in production
SECRET_KEY=super_secret_key_change_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Security & JWT (Admin Auth) ---
# Distinct cryptographic key for Admin token isolation
ADMIN_SECRET_KEY=admin_secret_key_change_in_production_12345
ADMIN_ALGORITHM=HS256
ADMIN_TOKEN_EXPIRE_MINUTES=480

# --- Networking ---
# The exact URI where the frontend Vite layer acts as client
FRONTEND_URL=http://localhost:5173
# Cross-Origin allowed domains
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:5175

# --- Resend.com SMTP (Transactional Emails) ---
# Used for password resets & verifications
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Google OAuth2 ---
# Credentials for single-sign-on
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Judge0 API (Code Execution) ---
# Used for compiling student code submissions
JUDGE0_API_URL=https://ce.judge0.com
