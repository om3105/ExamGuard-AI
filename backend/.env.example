# Backend Environment Variables Template
# Copy to .env and change values for production

# ─── Environment ───
ENVIRONMENT=development  # Set to 'production' for deployment

# ─── MongoDB Connection ───
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=examguard_db
# Server-selection timeout in milliseconds (default: 10000).
# Increase for high-latency or Atlas clusters; decrease for fast-fail in dev.
MONGODB_TIMEOUT_MS=10000

# ─── Security ───
# MUST change these in production to long, random strings!
# In production, the app will REFUSE to start with default keys.
SECRET_KEY=your_super_secret_production_key_here
ADMIN_SECRET_KEY=your_admin_super_secret_production_key_here
ALGORITHM=HS256

# ─── Access Token Expiry (minutes) ───
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS Configuration ───
# Comma-separated list of allowed origins
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:5175
# Production example:
# CORS_ORIGINS=https://examguard.vercel.app,https://admin.examguard.app

# ─── Judge0 Code Execution ───
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key_here

# ─── Logging ───
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
