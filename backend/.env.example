# ─── Backend Environment Variables ───
# Copy this file to .env and change values as needed.

# ─── Environment ───
ENVIRONMENT=development

# ─── MongoDB Connection ───
MONGODB_URL=mongodb://localhost:27017
DB_NAME=examguard

# ─── Security ───
# MUST change these in production to long, random strings!
SECRET_KEY=change_me_to_a_random_64_char_string
ADMIN_SECRET_KEY=change_me_to_a_different_random_64_char_string
ALGORITHM=HS256

# ─── Access Token Expiry (minutes) ───
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS Configuration ───
# Comma-separated allowed origins for frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:5175

# ─── Judge0 Code Execution ───
# Free public instance (no API key needed)
JUDGE0_API_URL=https://ce.judge0.com

# ─── Logging ───
LOG_LEVEL=INFO
TZ='Asia/Kolkata'
